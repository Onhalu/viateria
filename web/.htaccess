RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Override WEDOS default Cache-Control: max-age=259200 (3 days).
<IfModule mod_headers.c>
  # Entrypoint + Flutter loader / SW / build id: always revalidate.
  <FilesMatch "^(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|\.last_build_id)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Unhashed JS bundles (and deferred parts): never keep for multiple days.
  <FilesMatch "^(main\.dart\.js|main\.dart\.js_[0-9]+\.part\.js|flutter\.js)$">
    Header always set Cache-Control "max-age=0, must-revalidate"
  </FilesMatch>

  # Hashed / static assets (canvaskit, icons, fonts). Long cache is safe.
  <FilesMatch "\.(png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|otf|wasm)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(canvaskit\.js|skwasm\.js)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
