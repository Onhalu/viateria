# Copy to `.env` (gitignored) and run:
#   flutter run --dart-define-from-file=.env
#
# Never commit real secrets. Publishable / anon keys still belong in env,
# not in source.

SUPABASE_URL=
SUPABASE_ANON_KEY=
STRIPE_PUBLISHABLE_KEY=

# MapLibre vector style (Map Screen MVP).
# Production: MapTiler / Stadia / self-hosted OpenMapTiles, e.g.
#   MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
# Leave empty to use the documented non-prod OpenFreeMap Liberty fallback.
# TODO: set a production style URL before release.
# Never use https://tile.openstreetmap.org as a raster CDN.
MAP_STYLE_URL=

# Edge functions (supabase secrets) — not used by the Flutter client:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
