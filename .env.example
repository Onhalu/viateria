# Copy to `.env` (gitignored) and run:
#   flutter run --dart-define-from-file=.env
#
# Never commit real secrets. Publishable / anon keys still belong in env,
# not in source.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# OAuth, magic-link, and password-reset redirects are not secrets.
# The app sends the same redirectTo for all three:
#   com.viateria.viateria://login-callback          (iOS and Android)
#   https://viateria.limitlessdreams.cz/            (production web)
# Add both under Supabase Auth → Additional Redirect URLs.
# Google client secret and the Apple .p8 key stay in the Supabase dashboard.
# Never put the service_role key in this file.
STRIPE_PUBLISHABLE_KEY=

# MapLibre vector style (MapTiler / Stadia / self-hosted OpenMapTiles).
# Empty → non-prod fallback: https://tiles.openfreemap.org/styles/liberty
# Do not use https://tile.openstreetmap.org as a production raster CDN.
# MAP_STYLE_URL=

# Set to true only to force the bundled assets/map/pois.geojson catalog.
# Omit or false: the map reads public.places.
# USE_ASSET_PLACE_CATALOG=

# Edge functions (supabase secrets) — not used by the Flutter client:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
