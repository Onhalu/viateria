# Viateria environment variables
#
# With NONE of these set, Viateria runs in DEMO mode and serves bundled mock
# account data through the real code paths — the dashboard renders end-to-end.
# Add credentials (as Cloud Agent Secrets in production) to switch to live data.

# --- Live data: choose ONE auth family (never both) ---

# SSO / Bearer auth (from the eToro OAuth flow):
# ETORO_ACCESS_TOKEN=

# OR partner API-key auth (the pair is required together):
# ETORO_API_KEY=
# ETORO_USER_KEY=

# Which environment the credential belongs to: "demo" (default) or "real".
# ETORO_ENV=demo

# --- Sign in with eToro (OAuth SSO) ---
# ETORO_CLIENT_ID=
# ETORO_CLIENT_SECRET=
# ETORO_REDIRECT_URI=http://localhost:3000/api/auth/etoro/callback

# --- Overrides ---
# Force demo mode on/off regardless of credentials: "true" | "false"
# VIATERIA_DEMO=
